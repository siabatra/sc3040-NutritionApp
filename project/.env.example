# Copy to .env and fill in values shared privately by your group.
# EXPO_PUBLIC_ values are included in the client app bundle.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_DEEPSEEK_API_KEY=
EXPO_PUBLIC_USDA_API_KEY=
EXPO_PUBLIC_SERVER_URL=
EMAIL_USER=
EMAIL_PASS=

# Server-only OpenAI key. Never prefix this key with EXPO_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CHATBOT_PORT=4001
# Optional; for a physical phone use your computer's LAN IP, e.g. http://192.168.1.10:4001
EXPO_PUBLIC_CHATBOT_URL=
